<mujoco model="HummingBirdScene">
  <include file="HummingBird.xml"/>

  <statistic center="2.5 0 1.2" extent="7.0"/>

  <visual>
    <headlight diffuse="0.65 0.65 0.65" ambient="0.20 0.20 0.20" specular="0.12 0.12 0.12"/>
    <rgba haze="0.35 0.45 0.35 1"/>
    <global azimuth="-130" elevation="-35" ellipsoidinertia="false"/>
  </visual>

  <default>
    <default class="duct_wall">
      <geom contype="1" conaffinity="2" condim="3" friction="0.8 0.005 0.0001" solref="0.04 1" solimp="0.8 0.95 0.001" group="1"/>
    </default>

    <default class="duct_decor">
      <geom contype="0" conaffinity="0" group="5"/>
    </default>
  </default>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.5 0.5 0.5" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="forest_ground_tex" builtin="checker" mark="edge" rgb1="0.15 0.15 0.17" rgb2="0.1 0.1 0.1" markrgb="0.3 0.3 0.3" width="100" height="100"/>

    <material name="forest_ground" texture="forest_ground_tex" texuniform="true" texrepeat="2 2" reflectance="0"/>

    <material name="duct_material" rgba="0.43 0.47 0.52 1.0" specular="0.28" shininess="0.38" reflectance="0.06"/>
    <material name="duct_outer_transparent" rgba="0.20 0.48 0.70 0.24" specular="0.20" shininess="0.30"/>
    <material name="duct_top_transparent" rgba="0.20 0.48 0.70 0.06" specular="0.05" shininess="0.10" reflectance="0"/>
    <material name="duct_flange_material" rgba="0.17 0.19 0.22 1.0" specular="0.30" shininess="0.40"/>
  </asset>

  <worldbody>
    <light pos="2.5 0 10" dir="0 0 -1" directional="true"/>
    <light pos="-3 -5 6" dir="1 1 -1" directional="true" diffuse="0.35 0.32 0.25"/>

    <camera name="overview_camera" pos="2.5 -8.0 5.0" xyaxes="1 0 0 0 0.35 0.94" fovy="48"/>

    <geom name="floor" size="0 0 0.05" type="plane" material="forest_ground" contype="1" conaffinity="2" condim="3" friction="1.0 0.005 0.0001" solref="0.04 1" solimp="0.8 0.95 0.001"/>

    <!--
      Circular duct

      center          = (2.5, 0, 1.2)
      center radius   = 2.5 m

      inner width     = 0.80 m
      inner height    = 0.80 m

      wall thickness  = 0.12 m
      outer width     = 1.04 m
      outer height    = 1.04 m

      segment count   = 64
      segment angle   = 5.625 deg
    -->

    <body name="circular_duct" pos="2.5 0 1.2">

      <!-- ====================================================== -->
      <!-- MAIN DUCT: 64 segments                                 -->
      <!--                                                        -->
      <!-- local x : duct tangent                                 -->
      <!-- local y : radial direction                             -->
      <!-- local z : vertical                                     -->
      <!--                                                        -->
      <!-- +y wall = outside of circle = transparent              -->
      <!-- -y wall = inside of circle                             -->
      <!-- ====================================================== -->

      <replicate count="64" euler="0 0 0.0981747704">

        <body name="duct_segment" pos="-2.5 0 0" euler="0 0 1.5707963268">

          <geom name="duct_outer_wall" class="duct_wall" type="box" pos="0 0.46 0" size="0.150 0.06 0.52" material="duct_outer_transparent"/>
          <geom name="duct_inner_wall" class="duct_wall" type="box" pos="0 -0.46 0" size="0.150 0.06 0.52" material="duct_material"/>

          <!-- Keep top-wall collision while exposing the vehicle from above. -->
          <geom name="duct_top" class="duct_wall" type="box" pos="0 0 0.46" size="0.150 0.40 0.06" material="duct_top_transparent"/>
          <geom name="duct_bottom" class="duct_wall" type="box" pos="0 0 -0.46" size="0.150 0.40 0.06" material="duct_material"/>

        </body>

      </replicate>


      <!-- ====================================================== -->
      <!-- FLANGES                                                -->
      <!-- 16 flange rings = one every 22.5 deg                   -->
      <!-- visualization only, no collision                       -->
      <!-- ====================================================== -->

      <replicate count="16" euler="0 0 0.3926990817">

        <body name="duct_flange" pos="-2.5 0 0" euler="0 0 1.5707963268">

          <geom name="flange_outer" class="duct_decor" type="box" pos="0 0.545 0" size="0.018 0.025 0.57" material="duct_flange_material"/>
          <geom name="flange_inner" class="duct_decor" type="box" pos="0 -0.545 0" size="0.018 0.025 0.57" material="duct_flange_material"/>

          <geom name="flange_top" class="duct_decor" type="box" pos="0 0 0.545" size="0.018 0.52 0.025" material="duct_top_transparent"/>
          <geom name="flange_bottom" class="duct_decor" type="box" pos="0 0 -0.545" size="0.018 0.52 0.025" material="duct_flange_material"/>

        </body>

      </replicate>

    </body>

  </worldbody>
</mujoco>
